	(text "keep switching noise off the receiver front end."
		(exclude_from_sim no)
		(at 96.52 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "13c6d9f6-a29f-4375-b38f-412de4a4a28e")
	)
	(text "Place as TI does: C24 10nF-AVDD9 | C25 220pF-AVDD11 | C26 10nF-AVDD14 | C27 220pF-AVDD15"
		(exclude_from_sim no)
		(at 96.52 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1802d590-5528-4037-9fc5-b660e19b637b")
	)
	(text "FIRMWARE: GDO0 (pin 6) is an ACTIVE OUTPUT at power-on - a 135-141 kHz clock (datasheet s26)."
		(exclude_from_sim no)
		(at 96.52 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "18611c8d-82e8-40fc-8078-534afbaad2b1")
	)
	(text "433 MHz match — values and topology per TI CC1101EM reference (swrr046)."
		(exclude_from_sim no)
		(at 185.42 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1aca5317-e35b-4ce4-b0bc-a54af98e8dc4")
	)
	(text "Firmware drives it as TX data IN. Keep GPIO15 an input until IOCFG0.GDO0_CFG is written."
		(exclude_from_sim no)
		(at 96.52 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3a827695-4941-4acf-87f5-44b70c58aa2f")
	)
	(text "Two-section LC lowpass (L22/C33, L23/C34) transforms to 50 ohm, filters harmonics."
		(exclude_from_sim no)
		(at 185.42 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "593c6bf0-dc03-4e81-87c5-0a182f4af4f2")
	)
	(text "No series resistor fitted: the ESP32 boots its GPIOs as inputs, so ordering alone is sufficient."
		(exclude_from_sim no)
		(at 96.52 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "61a21f5e-0739-40c8-b80e-b8d54b835050")
	)
	(text "Exposed pad (pin 21): 5 tented vias, solder paste coverage under 100% (datasheet p.26, s7.8)."
		(exclude_from_sim no)
		(at 96.52 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "62b9f511-ce49-4d94-bb49-562d92f2e13b")
	)
	(text "Decoupling per TI reference: the 10nF / 220pF alternation across the four AVDD"
		(exclude_from_sim no)
		(at 96.52 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "69707ff3-43c0-40aa-98fd-66bc3ba40c07")
	)
	(text "Y2: 26 MHz, CL = 10 pF, +/-20 ppm. C20 = 12 pF and C21 = 15 pF are ASYMMETRIC on purpose:"
		(exclude_from_sim no)
		(at 140.97 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "74debb51-e4a4-48e0-9320-94fdd93f4c21")
	)
	(text "GDO0 carries TX data INTO the radio; GDO2 carries RX data OUT of it."
		(exclude_from_sim no)
		(at 140.97 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ad7f12de-0290-4799-8bce-ea21e62b2dcb")
	)
	(text "Balun C30/C31 + L20/L21 converts differential RF_P/RF_N to single-ended."
		(exclude_from_sim no)
		(at 185.42 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bbd7064f-121e-4331-befb-3a5971ce2e9b")
	)
	(text "LAYOUT-CRITICAL: CC1101 decoupling is PER-PIN. All 7 caps share one net, so nothing enforces it."
		(exclude_from_sim no)
		(at 96.52 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d33d6418-390d-4e91-8843-479b68cdcc95")
	)
	(text "XOSC_Q1 and XOSC_Q2 are not symmetric. Values per TI CC1101EM 434 MHz reference (SWRR046)."
		(exclude_from_sim no)
		(at 140.97 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e0cad09b-8aa5-4afe-aec9-a667ba9ae880")
	)
	(text "C35 is the antenna DC block. The match is band-specific — do not substitute values."
		(exclude_from_sim no)
		(at 185.42 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "eca1bd71-07f7-4b55-8f85-0f27a06b8a18")
	)
	(text "pins is deliberate, not an error. FB1 + the dedicated LDO on the Power sheet"
		(exclude_from_sim no)
		(at 96.52 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ee4ebca5-cb4b-4198-ab29-a7c6ea78d56f")
	)
	(text "C22 100nF-DVDD4 | C23 100nF-DCOUPL5 | C28 220pF-DGUARD18 | C29 1uF bulk at FB1 output."
		(exclude_from_sim no)
		(at 96.52 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
